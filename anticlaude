#!/usr/bin/env bash

set -euo pipefail

agent="${0##*/}"
agent="${agent#anti}"

case "$agent" in
    claude) agent_flags="--dangerously-skip-permissions" ;;
    codex)  agent_flags="--dangerously-bypass-approvals-and-sandbox" ;;
    *)      echo "Error: unknown agent '$agent'" >&2; exit 1 ;;
esac

workdir="$(pwd)"

if [[ -n "${STARDIR:-}" ]] && [[ "$workdir" == "$STARDIR" || "$workdir" == "$STARDIR/"* ]]; then
    echo "Error: Cannot start anticlaude in STARDIR or its subdirectories" >&2
    exit 1
fi

# Start an agent session in the vm
exec limactl shell --workdir "$workdir" default "$agent" $agent_flags "$@"
