#!/usr/bin/env bash

set -euo pipefail

workdir="$(pwd)"

if [[ -n "${STARDIR:-}" ]] && [[ "$workdir" == "$STARDIR" || "$workdir" == "$STARDIR/"* ]]; then
    echo "Error: Cannot start anticlaude in STARDIR or its subdirectories" >&2
    exit 1
fi

if [[ "$workdir" == "$HOME"* ]]; then
    name="${workdir#$HOME/}"
else
    name="${workdir#/}"
fi
name="anticlaude-${name//\//-}"
name="${name:-anticlaude-home}"

mkdir -p "$HOME/.claude"

# Ensure container is running (detached)
if podman container exists "$name" 2>/dev/null; then
    state=$(podman inspect -f '{{.State.Status}}' "$name")
    if [[ "$state" != "running" ]]; then
        podman start "$name" >/dev/null
    fi
else
    podman run --name "$name" --userns=keep-id -d \
        -v "$HOME/.claude:/home/anticlaude/.claude:z" \
        -v "$HOME/.gitconfig:/home/anticlaude/.gitconfig:ro,z" \
        -v "$HOME/.config/git:/home/anticlaude/.config/git:ro,z" \
        -v "$workdir:$workdir:z" -w "$workdir" \
        anticlaude:latest >/dev/null
fi

# Start a claude session in the running container
exec podman exec -it "$name" run-claude "$@"
